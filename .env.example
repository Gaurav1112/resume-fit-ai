# ---------------------------------------------------------------------------
# ResumeFit AI — configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Engine. The default needs no API key, no network and no model.
#
#   local     DEFAULT. Pure rules. Parses, matches, scores, validates and writes
#             entirely in code. Your bullets are kept verbatim and reordered for
#             the JD, so fabrication is structurally impossible. ~1 second.
#   ollama    local rules + a local LLM (Ollama) that rewords bullets. Still no
#             API key and still offline. Needs: ollama pull qwen2.5:7b
#   anthropic | openai | gemini   hosted models. Require an API key below.
#   mock      deterministic stubs, for tests only.
LLM_PROVIDER=local

# Model id. Leave blank to use the provider default.
#   local     -> local-rules  (not a model; the name is cosmetic)
#   ollama    -> qwen2.5:7b
#   anthropic -> claude-opus-5
#   openai    -> gpt-4.1
#   gemini    -> gemini-2.5-pro
LLM_MODEL=

# Reasoning effort for providers that support it (anthropic): low|medium|high|xhigh|max
# `high` is the API default. `medium` is a good cost/quality balance for this pipeline.
LLM_EFFORT=high

# --- API keys (only needed for the hosted providers; never sent to the browser) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Server ---
HOST=127.0.0.1
PORT=8000

# SQLite database path (resume versions + application tracker)
DB_PATH=./data/resumefit.db

# Max upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# Set to 1 to log full LLM prompts/responses to ./data/llm_trace.jsonl (debugging only —
# this file will contain your resume text; keep it local and delete when done).
LLM_TRACE=0
